{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Note & Quizzify Upload API",
    "description": "Upload ảnh/PDF → AI OCR → tạo flashcard/quiz → lưu SQLite. API dành cho MVP chạy cục bộ.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Kiểm tra API và kết nối SQLite",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/upload": {
      "post": {
        "tags": [
          "Upload"
        ],
        "summary": "Nhận ảnh/PDF, gọi AI và lưu tài liệu cùng flashcard/quiz",
        "description": "Gửi một file JPG/JPEG/PNG/WEBP/PDF (mặc định tối đa 10 MiB, PDF tối đa 20 trang). Trả 201 sau khi toàn bộ dữ liệu đã được lưu. Không cần gửi API key từ Frontend. Bỏ user_id để sử dụng hồ sơ cục bộ; user_id được gửi phải tồn tại. Tác vụ đồng bộ có thể mất tới AI_TIMEOUT_SECONDS, không cam kết hoàn tất dưới 3 giây.",
        "operationId": "upload_api_v1_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_api_v1_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Tệp rỗng/hỏng, tên tệp không hợp lệ hoặc PDF mã hóa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy user_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Tệp hoặc ảnh vượt giới hạn",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Định dạng không hỗ trợ hoặc MIME không khớp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Tham số sai, quá số trang hoặc không có chữ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Lỗi lưu SQLite; rollback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "AI lỗi hoặc JSON không hợp lệ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Chưa cấu hình AI, lỗi xác thực hoặc hết hạn mức",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "AI timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_api_v1_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Một ảnh JPG/JPEG/PNG/WEBP hoặc PDF"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id",
            "description": "UUID người dùng đã tồn tại; bỏ trống để dùng hồ sơ cục bộ"
          },
          "flashcard_count": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Flashcard Count",
            "description": "Số flashcard cần tạo",
            "default": 5
          },
          "quiz_count": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Quiz Count",
            "description": "Số câu trắc nghiệm, mỗi câu 4 lựa chọn",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_upload_post"
      },
      "DocumentOutput": {
        "properties": {
          "doc_id": {
            "type": "string",
            "format": "uuid",
            "title": "Doc Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "extracted_text": {
            "type": "string",
            "title": "Extracted Text"
          },
          "flashcards": {
            "items": {
              "$ref": "#/components/schemas/FlashcardOutput"
            },
            "type": "array",
            "title": "Flashcards"
          },
          "quizzes": {
            "items": {
              "$ref": "#/components/schemas/QuizOutput"
            },
            "type": "array",
            "title": "Quizzes"
          }
        },
        "type": "object",
        "required": [
          "doc_id",
          "user_id",
          "file_name",
          "extracted_text",
          "flashcards",
          "quizzes"
        ],
        "title": "DocumentOutput"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "error",
            "title": "Status",
            "default": "error"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FlashcardOutput": {
        "properties": {
          "card_id": {
            "type": "string",
            "format": "uuid",
            "title": "Card Id"
          },
          "front_text": {
            "type": "string",
            "title": "Front Text"
          },
          "back_text": {
            "type": "string",
            "title": "Back Text"
          }
        },
        "type": "object",
        "required": [
          "card_id",
          "front_text",
          "back_text"
        ],
        "title": "FlashcardOutput"
      },
      "QuizOutput": {
        "properties": {
          "quiz_id": {
            "type": "string",
            "format": "uuid",
            "title": "Quiz Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Options"
          },
          "correct_answer": {
            "type": "string",
            "title": "Correct Answer"
          }
        },
        "type": "object",
        "required": [
          "quiz_id",
          "question",
          "options",
          "correct_answer"
        ],
        "title": "QuizOutput"
      },
      "UploadResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status",
            "default": "success"
          },
          "data": {
            "$ref": "#/components/schemas/DocumentOutput"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "UploadResponse"
      }
    }
  }
}
