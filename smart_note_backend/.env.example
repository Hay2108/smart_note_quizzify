# ==========================================================
# Cấu hình môi trường cho Smart Note & Quizzify Backend
# Sao chép file này thành ".env" trong thư mục smart_note_backend
# và điền API key của bạn. TUYỆT ĐỐI không chia sẻ hoặc đưa file .env lên Git.
# ==========================================================

# Nhà cung cấp AI sử dụng ở backend: "gemini" hoặc "openai" (mặc định: gemini).
# Chỉ chọn 1 nhà cung cấp chính; toàn bộ API key luôn được giữ ở backend.
AI_PROVIDER=gemini

# API key của Google Gemini (lấy tại Google AI Studio).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Tên model Gemini (cần hỗ trợ đọc ảnh/PDF và Structured Output; mặc định: gemini-3.6-flash).
GEMINI_MODEL=gemini-3.6-flash

# API key của OpenAI (chỉ cần điền nếu đặt AI_PROVIDER=openai).
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Tên model OpenAI (cần hỗ trợ ảnh/PDF và Structured Output; mặc định: gpt-4.1).
OPENAI_MODEL=gpt-4.1

# Chuỗi kết nối cơ sở dữ liệu SQLite (bắt buộc bắt đầu bằng "sqlite:///").
# Để comment/trống để tự động dùng file smart_note.db trong thư mục smart_note_backend
# (hoạt động ổn định bất kể bạn chạy lệnh từ thư mục nào).
# DATABASE_URL=sqlite:///./smart_note.db

# Dung lượng tệp tải lên tối đa tính theo MB/MiB (giá trị hợp lệ: 1 đến 10; mặc định: 10).
MAX_UPLOAD_MB=10

# Số trang tối đa của một tệp PDF tải lên (giá trị hợp lệ: 1 đến 100; mặc định: 20).
MAX_PDF_PAGES=20

# Thời gian chờ tối đa (giây) cho hai bước AI (OCR + tạo học liệu), từ >0 đến 600 (mặc định: 120).
AI_TIMEOUT_SECONDS=120

# Số lần tự động thử lại khi AI trả lỗi tạm thời HTTP 429/5xx (giá trị hợp lệ: 0 đến 3; mặc định: 1).
AI_MAX_RETRIES=1

# Danh sách origin của Frontend (Streamlit) được phép gọi API qua CORS, cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
